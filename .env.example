# Telegram-бот (интерфейс автора): токен от @BotFather, id чата автора
TG_BOT_TOKEN=123456:ABC...
OWNER_CHAT_ID=123456789
POLL_INTERVAL=300

# LLM: любой OpenAI-совместимый endpoint (OpenAI, GigaChat-прокси, Ollama...).
# Пусто = встроенный mock, демо работает без ключей.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Источники (опционально, что не заполнено — не подключается)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TG_API_ID=
TG_API_HASH=
TG_CHANNEL=
